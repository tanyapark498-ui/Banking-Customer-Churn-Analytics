    "## Проверка диапазонов\n",
    "\n",
    "Кредитный скор обычно в диапазоне 300–850, возраст — реалистичные границы, баланс не должен быть отрицательным (если это не овердрафт)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "5e1d6561-a39a-44e5-abd9-fc4f71b35992",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "[  ок]  credit_sco вне 300-850: 0\n",
      "[  ок]  age < 18 или > 100: 0\n",
      "[  ок]  balance < 0: 0\n",
      "[  ок]  tenure_ye < 0: 0\n",
      "[  ок]  nums_card < 0: 0\n",
      "[  ок]  engagement_score вне 0-100: 0\n"
     ]
    }
   ],
   "source": [
    "checks = {\n",
    "    \"credit_sco вне 300-850\": ((df[\"credit_sco\"] < 300) | (df[\"credit_sco\"] > 850)).sum(),\n",
    "    \"age < 18 или > 100\": ((df[\"age\"] < 18) | (df[\"age\"] > 100)).sum(),\n",
    "    \"balance < 0\": (df[\"balance\"] < 0).sum(),\n",
    "    \"tenure_ye < 0\": (df[\"tenure_ye\"] < 0).sum(),\n",
    "    \"nums_card < 0\": (df[\"nums_card\"] < 0).sum(),\n",
    "    \"engagement_score вне 0-100\": ((df[\"engagement_score\"] < 0) | (df[\"engagement_score\"] > 100)).sum(),\n",
    "}\n",
    "for check, count in checks.items():\n",
    "    status = \"есть\" if count > 0 else \"ок\"\n",
    "    print(f\"[{status:>4}]  {check}: {count}\")"
   ]
  },
